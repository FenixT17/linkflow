# ──────────────────────────────────────────────
# LinkFlow — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.
# ──────────────────────────────────────────────

# Site URL — used for canonical URLs, sitemap, Open Graph, JSON-LD e links de
# verificação/recuperação (Appwrite createVerification/createRecovery).
# NEXT_PUBLIC_* são inlined no build — mudar este valor exige redeploy
# (Netlify → Site configuration → Environment variables, ou `netlify env:set`).
#
# ATUAL: https://linkflow-183.netlify.app (domínio temporário do Netlify; o
# canónico https://linkflou.qd.je ainda não está ativo no Netlify). Quando
# estiver live, voltar a definir para https://linkflou.qd.je e registar o
# hostname como Web platform no Appwrite (Home → Platforms), senão o
# createVerification falha com "Invalid url param".
NEXT_PUBLIC_SITE_URL=https://linkflow-183.netlify.app

# Distributed rate limiting (server-only, required in every environment)
# Create a Redis database at https://console.upstash.com/redis
# Never expose these values with NEXT_PUBLIC_ or commit them to Git.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token_here

# Appwrite Cloud configuration
# Get these values from your Appwrite Cloud project dashboard:
# https://cloud.appwrite.io/
#
# ⚠️ REGIÃO OBRIGATÓRIA — o endpoint TEM de corresponder à região onde o projeto
# foi criado no Appwrite Cloud. Usar o endpoint global (https://cloud.appwrite.io/v1)
# quando o projeto vive numa região regional devolve erro 401 em runtime:
#   "Project is not accessible in this region..." (general_access_forbidden)
# O projeto LinkFlow está criado na região Frankfurt → usar SEMPRE:
#   https://fra.cloud.appwrite.io/v1
# Para descobrir a região do teu projeto: Cloud Console → o URL do dashboard
# mostra o código da região (ex: cloud.appwrite.io = global, nyc.cloud.appwrite.io = Nova Iorque,
# fra.cloud.appwrite.io = Frankfurt, ...). O MESMO valor deve estar no GitHub
# Secret NEXT_PUBLIC_APPWRITE_ENDPOINT, porque é COMPILADO no bundle no build
# (alterar só o secret sem redeploy não tem efeito).
#
# Naming convention: NEXT_PUBLIC_APPWRITE_* is the CANONICAL name, used by BOTH
# the runtime code (src/lib/appwrite*.ts, API routes) and the CLI scripts
# (npm run provision, npm run fix:bucket, npm run provision:security-logs).
# The scripts also accept the legacy non-prefixed aliases (APPWRITE_ENDPOINT,
# APPWRITE_PROJECT_ID, APPWRITE_DATABASE_ID, APPWRITE_FILES_BUCKET_ID) for
# backwards compatibility with older .env.local files.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_APPWRITE_DATABASE_ID=linkflow
NEXT_PUBLIC_APPWRITE_AVATARS_BUCKET_ID=avatars
NEXT_PUBLIC_APPWRITE_BANNERS_BUCKET_ID=banners
# ⚠️ BUCKET IDs (plano gratuito): o Appwrite limita o nº de buckets por projeto.
# Se já existir um bucket criado na consola (ID aleatório), NÃO consegues criar
# um novo com ID fixo — define NEXT_PUBLIC_APPWRITE_FILES_BUCKET_ID com o ID do
# bucket existente (o runtime e o script de provision usam este valor).
# O bucket é privado: as imagens são servidas pelo proxy /api/media/[fileId]
# com a API key do servidor.
NEXT_PUBLIC_APPWRITE_FILES_BUCKET_ID=files

# Server-side only (kept secret from the browser)
# Create an API key in Appwrite with these scopes:
# databases.read, databases.write, collections.read, collections.write,
# attributes.write, indexes.write, buckets.read, buckets.write, files.read, files.write,
# users.write (required by account deletion to remove the Appwrite identity)
APPWRITE_API_KEY=your_api_key_here

# Resend transactional email — RESERVED FOR FUTURE USE (currently disabled)
# Do not configure or activate these variables while email sending is disabled.
# When re-enabled, keep them server-side only: never use NEXT_PUBLIC_ and never
# expose these values to the browser, Git, or logs.
RESEND_API_KEY=your_resend_api_key_here
# Future sender; use a verified custom domain when email is activated.
RESEND_FROM_EMAIL=LinkFlow <onboarding@resend.dev>
# Optional future reply-to address.
RESEND_REPLY_TO=

# Stripe (if applicable)
# Publishable key is public — safe for frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secret key is PRIVATE — server-only
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ──────────────────────────────────────────────
# Cloudflare Workers — runtime secrets (server-only)
# ──────────────────────────────────────────────
# NUNCA commitar estes valores. Definir no dashboard do Cloudflare
# (Workers & Pages → linkflow → Settings → Variables and Secrets) ou via
# `npx wrangler secret put NOME`. O GitHub Actions (deploy.yml) envia-os
# automaticamente a partir de GitHub Secrets em cada deploy:
#   APPWRITE_API_KEY
#   UPSTASH_REDIS_REST_URL
#   UPSTASH_REDIS_REST_TOKEN
#   IP_HASH_SECRET
# (localmente, para `wrangler dev`, criar um ficheiro .dev.vars gitignored
# com estes mesmos valores)

# Segredo para derivar o visitorHash (HMAC-SHA256) — M1.
# Sem ele, o código usa um salt fixo legado (menos seguro: um atacante com
# acesso à BD consegue reverter o IP por força bruta sobre o espaço IPv4).
# Gerar um valor aleatório longo (ex: `openssl rand -hex 32`) e NUNCA o
# expor no bundle (não usar NEXT_PUBLIC_). Definir este valor reinicia os
# contadores de visitantes únicos (os hashes antigos deixam de coincidir).
# IP_HASH_SECRET=your_random_secret_here
