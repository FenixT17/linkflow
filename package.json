{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "provision": "tsx scripts/provision-appwrite.ts",
    "fix:bucket": "tsx scripts/fix-bucket-public.ts",
    "provision:security-logs": "tsx scripts/create-security-logs.ts",
    "migrate:staff-applications": "tsx scripts/migrate-staff-applications.ts",
    "migrate:users-permissions": "tsx scripts/migrate-users-permissions.ts",
    "migrate:study-data": "tsx scripts/migrate-study-data.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "check:links": "tsx scripts/check-links.ts",
    "verify:account-deletion": "tsx --env-file=.env.local scripts/verify-account-deletion.ts",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@upstash/redis": "^1.38.2",
    "appwrite": "^26.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "next": "15.5.22",
    "node-appwrite": "26.1.0",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.15.0",
    "simple-icons": "^16.27.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.25",
    "@hono/node-server": "^2.0.12",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.17"
    }
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true
  }
}
